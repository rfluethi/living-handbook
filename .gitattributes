# What `git archive` leaves out, and so GitHub's "Source code (zip)" and
# "Source code (tar.gz)" downloads on a release page.
#
# This file does NOT decide what is in the plugin ZIP. bin/build.sh assembles
# that from the working tree with an explicit list of what ships, and it reads
# nothing from git. The installable ZIP is the one attached to each release
# (living-handbook-<version>.zip), not the source archives.
#
# docs/ is not excluded: the four handbooks under docs/ are runtime content,
# imported by the "App handbook" tab, and they ship in the plugin ZIP as well.
/.github export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.mailmap export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
# The Node lint tooling: development only, the plugin ships assets/ as it is.
/package.json export-ignore
/package-lock.json export-ignore
/eslint.config.mjs export-ignore
/stylelint.config.mjs export-ignore
/.prettierignore export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md export-ignore
