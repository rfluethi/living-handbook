# Dependencies
/vendor/
/node_modules/

# Build artifacts (never commit the built zip or an extracted copy)
/build/
/dist/
/living-handbook/
living-handbook-*.zip
*.zip

# Tooling caches
.phpunit.result.cache
.phpcs.cache

# Build tooling kept locally, not in the repository (see bin/build.sh)
/tools/

# Local WordPress test library
/wordpress/
/tmp/

# Compiled translations
/languages/*.mo

# Patches waiting to be applied, and the leftovers of a patch run
# (patch -F3 writes .orig and .rej next to the file)
*.patch
*.orig
*.rej

# Editor and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
wp-tests-config.php
