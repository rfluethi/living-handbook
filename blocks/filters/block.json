{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "living-handbook/filters",
	"title": "Handbook filter bar",
	"category": "living-handbook",
	"icon": "filter",
	"description": "The filter bar of a handbook: page type, topic, responsibility and audience of the pages in it. Only offers terms that are actually used.",
	"keywords": [ "handbook", "living handbook", "filter", "documentation" ],
	"textdomain": "living-handbook",
	"editorScript": "living-handbook-blocks",
	"viewScript": "living-handbook",
	"style": "living-handbook",
	"example": {},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	}
}
