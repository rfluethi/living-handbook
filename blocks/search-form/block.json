{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "living-handbook/search-form",
	"title": "Handbook search bar",
	"category": "living-handbook",
	"icon": "search",
	"description": "The search bar of a handbook: submits to the handbook and narrows the list of pages. Keeps the active filters.",
	"keywords": [ "handbook", "living handbook", "search", "documentation" ],
	"textdomain": "living-handbook",
	"editorScript": "living-handbook-blocks",
	"viewScript": "living-handbook",
	"style": "living-handbook",
	"example": {},
	"attributes": {
		"showLabel": {
			"type": "boolean",
			"default": false
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"buttonPosition": {
			"type": "string",
			"default": "button-outside"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"customClassName": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	}
}
