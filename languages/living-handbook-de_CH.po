#: blocks/badges/block.json
msgctxt "block title"
msgid "Handbook badges"
msgstr "Handbuch-Badges"

#: blocks/badges/block.json
msgctxt "block description"
msgid "Handbook badges: page type, topic and audience of the current page."
msgstr "Handbuch-Badges: Seitentyp, Thema und Zielgruppe der aktuellen Seite."

#: blocks/badges/block.json blocks/entry/block.json blocks/feedback/block.json
#: blocks/filters/block.json blocks/lessons/block.json blocks/menu/block.json
