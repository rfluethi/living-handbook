#: blocks/search-form/block.json blocks/search/block.json blocks/toc/block.json
msgctxt "block keyword"
msgid "handbook"
msgstr "Handbuch"

#: blocks/badges/block.json blocks/entry/block.json blocks/feedback/block.json
#: blocks/filters/block.json blocks/lessons/block.json blocks/menu/block.json
#: blocks/mermaid/block.json blocks/navigation/block.json
