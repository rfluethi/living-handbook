#, php-format
#~ msgid ""
#~ "The mkdocs.yml could not be read (%s), so the files were imported flat, "
#~ "with their file names as titles and without the navigation structure."
#~ msgstr ""
#~ "Die mkdocs.yml konnte nicht gelesen werden (%s), deshalb wurden die "
