<?xml version="1.0"?>
<ruleset name="Living Handbook">
	<description>Coding standards for the Living Handbook plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<!-- Local test harness config, not part of the plugin and not committed. -->
	<exclude-pattern>/wp-tests-config.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Only errors fail the build; warnings are reported but non-blocking. -->
	<config name="ignore_warnings_on_exit" value="1"/>
	<config name="minimum_supported_wp_version" value="6.7"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Plugin Check runs the full WordPress standard, which carries two groups
	     that WordPress-Extra does not. Without them, findings that block a
	     wordpress.org submission only surface after a release: three did, in
	     0.62.0. Adding them here is what makes "composer lint is green" mean
	     "Plugin Check is green". -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>

	<!-- PSR-4 autoloading uses StudlyCase class filenames, so the WordPress
	     file-name sniff does not apply to the src/ classes. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<!-- PHP-Scoper looks for a file of exactly this name. -->
		<exclude-pattern>/scoper.inc.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="living-handbook"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="LivingHandbook"/>
				<element value="living_handbook"/>
				<element value="LIVING_HANDBOOK"/>
			</property>
		</properties>
	</rule>
</ruleset>
